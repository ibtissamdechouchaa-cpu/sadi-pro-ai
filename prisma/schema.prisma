generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  industry          String?
  country           String?
  defaultLanguage   String    @default("en")
  timezone          String    @default("UTC")
  logoUrl           String?
  planTier          String    @default("trialing")
  subscriptionState String    @default("trialing")
  trialEndsAt       DateTime?
  maxUsers          Int       @default(5)
  maxStorageBytes   BigInt    @default(209715200)
  maxDocuments      Int       @default(500)
  settings          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

model Profile {
  id              String    @id
  organizationId  String?
  email           String    @unique
  fullName        String
  avatarUrl       String?
  avatarColor     String    @default("#2563eb")
  role            String    @default("viewer")
  departmentId    String?
  isActive        Boolean   @default(true)
  passwordHash    String
  lastLoginAt     DateTime?
  language        String    @default("en")
  timezone        String    @default("UTC")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Department {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  color           String    @default("#2563eb")
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
}

model Document {
  id                String    @id @default(uuid())
  organizationId    String
  title             String
  description       String?
  type              String    @default("other")
  typeConfidence    Float     @default(0)
  language          String    @default("unknown")
  departmentId      String?
  ownerUserId       String?
  classification    String    @default("internal")
  archiveState      String    @default("active")
  approvalState     String    @default("draft")
  status            String    @default("uploading")
  priority          String    @default("medium")
  signatureState    String    @default("not_required")
  fileSize          BigInt    @default(0)
  fileType          String?
  filePath          String?
  storageBucket     String    @default("documents")
  uploadedBy        String?
  uploadedAt        DateTime  @default(now())
  modifiedAt        DateTime  @default(now())
  tags              String[]
  version           Int       @default(1)
  hash              String?
  pageCount         Int       @default(0)
  ocrCompleted      Boolean   @default(false)
  embeddingCompleted Boolean  @default(false)
  relatedDocIds     String[]
  retentionYears    Int?
  retentionReason   String?
  expiresAt         DateTime?
  legalHold         Boolean   @default(false)
  sharedWith        String[]
  documentNumber    String?
  issuingAuthority  String?
  documentDate      DateTime?
  notes             String?
  contractNumber    String?
  institution       String?
  legalValue        String?   // high / medium / low / permanent
  historicalValue   String?
  sourceLanguage    String?
  metadata          Json      @default("{}")
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([departmentId])
  @@index([uploadedAt])
  @@index([priority])
  @@index([archiveState])
  @@index([expiresAt])
}

model DocumentVersion {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  version         Int
  uploadedBy      String?
  uploadedByName  String?
  filePath        String?
  fileSize        BigInt    @default(0)
  hash            String?
  changes         String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())

  @@index([documentId])
  @@index([organizationId])
}

model DisposalRequest {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  requestedBy     String
  requestedByName String?
  reason          String?
  status          String    @default("pending")
  approvedBy      String?
  approvedByName  String?
  approvedAt      DateTime?
  disposedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([documentId])
  @@index([organizationId])
  @@index([status])
}

model LegalReference {
  id              String    @id @default(uuid())
  referenceNumber String
  referenceType   String
  title           String
  date            DateTime?
  subject         String?
  description     String?
  retentionRules  Json      @default("{}")
  accessRules     Json      @default("{}")
  disposalRules   Json      @default("{}")
  archiveRules    Json      @default("{}")
  status          String    @default("active")
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([referenceType])
  @@index([organizationId])
}

model DocumentSummary {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  level           String    // short | standard | detailed
  summary         String
  keywords        String[]
  importantDates  Json      @default("[]")
  parties         Json      @default("[]")
  createdAt       DateTime  @default(now())
  @@index([documentId])
  @@index([organizationId])
}

model DocumentEmbedding {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  chunkIndex      Int       @default(0)
  content         String
  embedding       Json      @default("[]")
  createdAt       DateTime  @default(now())
  @@index([documentId])
  @@index([organizationId])
}

model DocumentRetentionEvent {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  fromYears       Int?
  toYears         Int
  reason          String?
  decidedBy       String?
  decidedAt       DateTime  @default(now())
  @@index([documentId])
}

model LegalRule {
  id              String    @id @default(uuid())
  referenceId     String?
  ruleType        String    // retention | access | disposal | archive
  condition       Json      @default("{}")
  action          String
  priority        Int       @default(0)
  createdAt       DateTime  @default(now())
  @@index([referenceId])
}

model DocumentLegalMatch {
  id              String    @id @default(uuid())
  documentId      String
  legalReferenceId String
  confidence      Float     @default(0)
  matchedAt       DateTime  @default(now())
  @@index([documentId])
  @@index([legalReferenceId])
}

model Signature {
  id              String    @id @default(uuid())
  documentId      String
  organizationId  String
  signerId        String
  signerName      String?
  signerEmail     String?
  order           Int       @default(0)
  status          String    @default("pending")
  signedAt        DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  ipAddress       String?
  documentVersion Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([documentId])
  @@index([organizationId])
  @@index([status])
}

model ProcessingJob {
  id              String    @id @default(uuid())
  organizationId  String
  documentId      String?
  documentName    String?
  stage           String    @default("queued")
  progress        Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  error           String?
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([documentId])
  @@index([stage])
}

model AuditLog {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String?
  action          String
  resourceType    String?
  resourceId      String?
  resourceName    String?
  metadata        Json      @default("{}")
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model ActivityEvent {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String?
  userName        String?
  action          String
  resource        String?
  icon            String?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([createdAt])
}

model Notification {
  id              String    @id @default(uuid())
  organizationId  String
  userId          String
  type            String    @default("info")
  title           String
  message         String?
  read            Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([organizationId, userId])
  @@index([read])
}

model RetentionPolicy {
  id                String    @id @default(uuid())
  organizationId    String
  name              String
  documentType      String?
  departmentId      String?
  jurisdiction      String?
  sector            String?
  retentionYears    Int
  dispositionAction String    @default("delete")
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Collection {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isAiSuggested   Boolean   @default(false)
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DocumentTemplate {
  id              String    @id @default(uuid())
  organizationId  String?
  name            String
  type            String    @default("other")
  classification  String    @default("internal")
  fields          Json      @default("{}")
  isSystem        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  @@index([organizationId])
}

model Workflow {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  triggerType     String
  conditions      Json      @default("{}")
  actions         Json      @default("[]")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
